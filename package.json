{
  "name": "snowday",
  "version": "1.0.0",
  "private": true,
  "description": "SnowDay \u2014 hyperlocal US snowfall forecasts and school closure predictions",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:apis": "tsx --conditions=react-server scripts/smoke-apis.ts",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "import:nces": "tsx scripts/import-nces.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "clsx": "2.1.1",
    "fast-xml-parser": "5.12.0",
    "framer-motion": "12.43.0",
    "lucide-react": "0.577.0",
    "maplibre-gl": "6.17.0",
    "next": "16.4.5",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "recharts": "2.15.4",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/web-push": "3.6.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.1.18",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
