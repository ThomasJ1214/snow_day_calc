# ─────────────────────────────────────────────────────────────────────────────
# SnowDay environment variables. Copy this file to `.env.local` for local
# development, and add the same names in Vercel → Project → Settings →
# Environment Variables for production. Every variable is OPTIONAL: with none
# set, forecasts, maps, school search and Montville's official status all work.
# ─────────────────────────────────────────────────────────────────────────────

# Your site's public address (used for links, sitemap and the weather.gov User-Agent).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact email sent to the National Weather Service API with each request (NWS asks for one).
NWS_CONTACT_EMAIL=you@example.com

# ── Supabase: school directory import, accounts, saved favorites, notifications ──
# Supabase → Project Settings → API. The anon key is safe to expose; the service-role key is NOT.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Used by cron jobs and `npm run import:nces`.
SUPABASE_SERVICE_ROLE_KEY=
# Force live NCES lookups even when Supabase is configured (normally leave unset).
# SCHOOLS_SOURCE=nces-edge

# ── Web Push notifications ── generate with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Scheduled jobs ── any long random string (e.g. from `openssl rand -hex 32`).
# Vercel Cron sends it automatically; external schedulers must send "Authorization: Bearer <value>".
CRON_SECRET=

# ── Optional: Open-Meteo commercial API key (higher limits; required for commercial use) ──
OPEN_METEO_API_KEY=
